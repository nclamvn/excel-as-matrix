# Supabase — Required for real-time collaboration
# Create a free project at https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave empty to run in offline mode (no collaboration)

# Server runtime — development defaults to port 3001 and the two local Vite origins.
# Production must set an explicit comma-separated allowlist; wildcard origins are rejected.
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional server capabilities. Leave blank to disable their routes safely.
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SCIM_BEARER_TOKEN=
